<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <Sequence name="ArmOnlySequence">
      <ExecuteArmSequence name="arm"
                          timeout="10.0"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ExecuteArmSequence">
      <input_port name="timeout"
                  default="10.0">机械臂动作序列超时时间（秒）</input_port>
    </Action>
  </TreeNodesModel>

</root>